{
  "name": "OutputPref",
  "type": "object",
  "properties": {
    "screen_path": {
      "type": "string",
      "description": "Página da saída (/Projection, /LyricProjection, ...): a janela no computador e as telas na rede que mostram essa página"
    },
    "name": {
      "type": "string",
      "default": "",
      "description": "Nome desta saída no console e nas telas na rede; vazio usa o padrão"
    },
    "icon": {
      "type": "string",
      "default": "",
      "description": "Ícone da saída (nome do ícone do design system); vazio usa o padrão"
    },
    "options": {
      "type": "object",
      "default": {},
      "description": "Opções próprias da página (Palco: cifra, relógio, notas, próximo; Pastor: relógio, quantos próximos)"
    },
    "content": {
      "type": "string",
      "enum": [
        "",
        "all",
        "lyrics",
        "video",
        "notices"
      ],
      "default": "",
      "description": "O que a saída mostra: vazio é o padrão da página"
    },
    "hidden_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lyrics",
          "bible",
          "text",
          "media",
          "tool",
          "communication",
          "alert"
        ]
      },
      "default": [],
      "description": "Tipos que esta saída não mostra (letras, Bíblia, texto, imagens e vídeos, relógio e timer, avisos, aviso rápido); vazio mostra tudo o que a página mostra"
    },
    "text_scale": {
      "type": "number",
      "default": 100,
      "description": "Escala do texto em % (80 a 140)"
    },
    "margin_pct": {
      "type": "number",
      "default": 0,
      "description": "Margem extra do texto em % da largura (0 a 10)"
    },
    "show_logo": {
      "type": "boolean",
      "default": true,
      "description": "Mostrar o logo da camada Logo nesta saída"
    },
    "theme_id": {
      "type": "string",
      "default": "",
      "description": "Tema próprio da saída (ProjectionTheme); vazio herda o da projeção"
    },
    "layout_id": {
      "type": "string",
      "default": "",
      "description": "O layout que a tela desenha (ScreenLayout, ou um layout de fábrica: factory:palco, factory:pastor); vazio é a tela padrão da página (Palco e Pastor)"
    }
  },
  "required": [
    "screen_path"
  ]
}
