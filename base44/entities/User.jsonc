{
  "name": "User",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "pt",
        "en",
        "es",
        "fr"
      ],
      "default": "pt",
      "description": "Idioma da interface"
    },
    "background_url": {
      "type": "string",
      "description": "URL da imagem de fundo"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo"
    },
    "transition_type": {
      "type": "string",
      "enum": ["fade", "slide", "cut"],
      "description": "Transicao padrao entre slides nas telas (Configuracoes › Aparencia): esmaecer, deslizar ou corte"
    },
    "transition_ms": {
      "type": "integer",
      "description": "Duracao padrao da transicao entre slides, em milissegundos (120 a 600)"
    },
    "show_forecast": {
      "type": "boolean",
      "default": false,
      "description": "Mostrar a previsao do fim do culto e o atraso (termina ~, passou N min): so para igrejas que planejam o culto com duracoes"
    },
    "standby_background": {
      "type": "string",
      "description": "Fundo de espera padrao: a imagem das telas quando nada esta no ar, se o culto nao tiver o seu (URL de midia ou fundo incluido)"
    },
    "church_name": {
      "type": "string",
      "description": "Nome da igreja (Configurações › Igreja)"
    },
    "church_city": {
      "type": "string",
      "description": "Cidade da igreja"
    },
    "primary_color": {
      "type": "string",
      "default": "#84cc16",
      "description": "Cor prim\u00e1ria (hex)"
    },
    "secondary_color": {
      "type": "string",
      "default": "#10b981",
      "description": "Cor secund\u00e1ria (hex)"
    },
    "navbar_primary_color": {
      "type": "string",
      "default": "#84cc16",
      "description": "Cor prim\u00e1ria da barra de navega\u00e7\u00e3o (hex)"
    },
    "navbar_secondary_color": {
      "type": "string",
      "default": "#10b981",
      "description": "Cor secund\u00e1ria da barra de navega\u00e7\u00e3o (hex)"
    },
    "submenu_primary_color": {
      "type": "string",
      "default": "#6366f1",
      "description": "Cor prim\u00e1ria do submenu / menu de navega\u00e7\u00e3o (hex)"
    },
    "submenu_secondary_color": {
      "type": "string",
      "default": "#a855f7",
      "description": "Cor secund\u00e1ria do submenu / menu de navega\u00e7\u00e3o (hex)"
    },
    "device_mode": {
      "type": "string",
      "enum": [
        "mobile",
        "tablet",
        "desktop"
      ],
      "default": "desktop",
      "description": "Modo de visualiza\u00e7\u00e3o"
    }
  },
  "required": []
}