{
  "name": "VolunteerSchedule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da escala"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da escala"
    },
    "service_title": {
      "type": "string",
      "description": "Nome do culto/evento"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Fun\u00e7\u00e3o (ex: Vocalista, Tecladista, Operador de M\u00eddia)"
          },
          "assignee_name": {
            "type": "string",
            "description": "Nome do volunt\u00e1rio"
          },
          "assignee_phone": {
            "type": "string",
            "description": "Telefone do volunt\u00e1rio"
          },
          "confirmed": {
            "type": "boolean",
            "default": false
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Atribui\u00e7\u00f5es da escala"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "confirmed",
        "completed"
      ],
      "default": "draft",
      "description": "Estado da escala"
    },
    "notes": {
      "type": "string",
      "description": "Notas gerais"
    }
  },
  "required": [
    "title",
    "date"
  ]
}