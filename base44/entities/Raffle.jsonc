{
  "name": "Raffle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do sorteio"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de participantes"
    },
    "winner": {
      "type": "string",
      "description": "Vencedor sorteado"
    },
    "runners_up": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Segundos lugares"
    },
    "num_winners": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de vencedores"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Sorteio ativo para proje\u00e7\u00e3o"
    },
    "drawn_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data do sorteio"
    }
  },
  "required": [
    "name",
    "participants"
  ]
}