{
  "name": "ServiceMessage",
  "type": "object",
  "properties": {
    "serviceId": {
      "type": "string",
      "description": "Culto da mensagem (Service.id; sem culto, a setlist de hoje)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "chat",
        "pedido"
      ],
      "default": "chat",
      "description": "chat = mensagem entre a equipe e o operador; pedido = pedido de louvor"
    },
    "sender": {
      "type": "string",
      "description": "Quem mandou, como escreveu no celular (Equipe; até 40 letras); \"Operador\" quando side = operator"
    },
    "text": {
      "type": "string",
      "description": "A mensagem, ou a observação do pedido (até 280 letras)"
    },
    "singer": {
      "type": "string",
      "description": "Pedido: quem canta"
    },
    "song": {
      "type": "string",
      "description": "Pedido: o louvor, como escrito"
    },
    "songId": {
      "type": "string",
      "description": "Pedido: a música da biblioteca (Song.id), quando escolhida de lá"
    },
    "mediaId": {
      "type": "string",
      "description": "Pedido: um vídeo ou áudio da Mídia (Media.id), quando escolhido de lá (Rodada Q, S15); nunca junto com songId"
    },
    "link": {
      "type": "string",
      "description": "Um link do YouTube, sempre reescrito pelo console (https://www.youtube.com/watch?v=<id>)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done"
      ],
      "default": "open",
      "description": "open = a atender; done = atendido"
    },
    "side": {
      "type": "string",
      "enum": [
        "",
        "team",
        "operator"
      ],
      "description": "Quem escreveu (Rodada Q, S12/S14): team = um celular da Equipe; operator = o operador, no console (uma resposta no Chat ou um pedido anotado). Vazio = team (linhas de antes)"
    },
    "sentAt": {
      "type": "string",
      "description": "Quando chegou (ISO 8601); a lista vai por ordem de chegada"
    },
    "source": {
      "type": "string",
      "enum": [
        "",
        "gerar"
      ],
      "description": "De onde veio (owner 2026-11-18): vazio = um celular ou o operador; gerar = o GERAR da igreja (electron/gerarInbox.cjs), com o selo GERAR no cartão"
    },
    "external_id": {
      "type": "string",
      "description": "O id do pedido ou da mensagem no GERAR (source = gerar): por ele o estado vai e volta"
    },
    "gerar_event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "description": "O culto do GERAR de onde veio (só para mostrar, na 2ª linha do cartão; o pedido entra no culto visível do console)"
    },
    "gerar_category": {
      "type": "string",
      "description": "A categoria do pedido no GERAR (song, playback, video, microphone, announcement, stage, lighting, streaming, other): fora das três de música o cartão diz \"pede:\" (D6 = A)"
    },
    "gerar_file": {
      "type": "string",
      "enum": [
        "",
        "downloading",
        "failed"
      ],
      "description": "Os arquivos anexados ao pedido no GERAR (onda 4): downloading = baixando para a Mídia (\"baixando…\" no cartão); failed = um não veio; vazio = nenhum ou todos chegaram"
    },
    "gerar_status": {
      "type": "string",
      "description": "O estado do pedido no GERAR (new, in_review, preparing, ready, completed, declined, cancelled): cancelled ou declined = \"cancelado no GERAR\", apagado na fila (D3 = A)"
    }
  },
  "required": [
    "serviceId",
    "kind",
    "sentAt"
  ]
}
