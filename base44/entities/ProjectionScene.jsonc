{
  "name": "ProjectionScene",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da cena"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da cena"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "description": "ID do dispositivo"
          },
          "device_name": {
            "type": "string",
            "description": "Nome do dispositivo"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "lyrics",
              "bible",
              "video",
              "image",
              "announcement",
              "countdown",
              "blank",
              "logo"
            ]
          },
          "content_title": {
            "type": "string",
            "description": "T\u00edtulo do conte\u00fado"
          },
          "content_data": {
            "type": "object",
            "description": "Dados adicionais do conte\u00fado"
          }
        }
      },
      "description": "Atribui\u00e7\u00f5es por dispositivo"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Cena ativa"
    }
  },
  "required": [
    "name"
  ]
}