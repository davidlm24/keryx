{
  "name": "Song",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da m\u00fasica"
    },
    "artist": {
      "type": "string",
      "description": "Artista ou banda"
    },
    "lyrics": {
      "type": "string",
      "description": "Letra completa da m\u00fasica"
    },
    "duration": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em segundos"
    },
    "audio_url": {
      "type": "string",
      "description": "URL do arquivo de \u00e1udio (MP3/MP4)"
    },
    "background_image": {
      "type": "string",
      "description": "URL da imagem de fundo personalizada"
    },
    "theme_id": {
      "type": "string",
      "default": "",
      "description": "Tema da música (ProjectionTheme): enquanto existir, manda no visual inteiro e mudar o tema muda a música; vazio usa o visual próprio (fonte, cores, fundo) desta música"
    },
    "part_themes": {
      "type": "object",
      "default": {},
      "description": "Tema por parte da letra: o nome da parte ([Refrão], [Ponte]...) em minúsculas -> id do ProjectionTheme; os slides dessa parte usam o tema inteiro"
    },
    "lines_per_slide": {
      "type": "integer",
      "enum": [0, 2, 4],
      "description": "Como a letra vira slides: 0 = uma estrofe por slide, 2 ou 4 = no maximo tantas linhas por slide (editor de musica)"
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "description": "Dura\u00e7\u00e3o do slide em segundos"
          }
        }
      },
      "description": "Slides individuais com dura\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "enum": [
        "worship",
        "praise",
        "hymn",
        "contemporary",
        "louvor",
        "adoracao",
        "infantil",
        "ceia",
        "other",
        "outro"
      ],
      "default": "worship",
      "description": "Categoria da m\u00fasica"
    },
    "font_size": {
      "type": "string",
      "enum": [
        "xsmall",
        "small",
        "medium",
        "large",
        "xlarge",
        "xxlarge"
      ],
      "default": "large",
      "description": "Tamanho da letra na proje\u00e7\u00e3o"
    },
    "font_family": {
      "type": "string",
      "enum": [
        "sans",
        "serif",
        "mono",
        "cursive",
        "arial",
        "georgia",
        "times",
        "verdana"
      ],
      "default": "sans",
      "description": "Tipo de fonte na proje\u00e7\u00e3o"
    },
    "text_effect": {
      "type": "string",
      "enum": [
        "shadow",
        "glow",
        "outline",
        "double-shadow",
        "3d",
        "neon",
        "none"
      ],
      "default": "shadow",
      "description": "Efeito visual do texto"
    },
    "text_color": {
      "type": "string",
      "default": "#ffffff",
      "description": "Cor do texto"
    },
    "text_color_2": {
      "type": "string",
      "description": "Segunda cor para gradiente (opcional)"
    },
    "bpm": {
      "type": "number",
      "description": "Andamento da m\u00fasica (BPM)"
    },
    "song_key": {
      "type": "string",
      "description": "Tonalidade da m\u00fasica (ex: C, G, Am, F#m)"
    },
    "chords": {
      "type": "string",
      "description": "Cifra da m\u00fasica"
    },
    "musician_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es para m\u00fasicos"
    },
    "ccli_number": {
      "type": "string",
      "description": "N\u00famero CCLI da m\u00fasica (para licenciamento)"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "M\u00fasica favorita"
    },
    "last_played_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da \u00faltima vez que foi tocada"
    },
    "play_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de vezes que foi tocada"
    }
  },
  "required": [
    "title",
    "lyrics"
  ]
}