{
  "name": "Media",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da m\u00eddia"
    },
    "type": {
      "type": "string",
      "enum": [
        "video",
        "powerpoint",
        "image",
        "pdf",
        "gif",
        "audio"
      ],
      "description": "Tipo de m\u00eddia"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL da miniatura"
    },
    "duration": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em segundos (para v\u00eddeos)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da m\u00eddia"
    },
    "category": {
      "type": "string",
      "enum": [
        "sermon",
        "worship",
        "announcement",
        "testimony",
        "other",
        "background"
      ],
      "default": "other",
      "description": "Categoria da m\u00eddia"
    }
  },
  "required": [
    "title",
    "type",
    "file_url"
  ]
}